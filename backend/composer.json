{
  "name": "rendezvous/backend-api",
  "description": "Backend em PHP 8.3 com Swoole WebSockets, MySQL 8.4, Escrow PIX e API do Guia de Motéis para o Rendezvous",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-swoole": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-redis": "*",
    "ext-openssl": "*",
    "guzzlehttp/guzzle": "^7.8",
    "firebase/php-jwt": "^6.10",
    "vlucas/phpdotenv": "^5.6",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Rendezvous\\": "app/"
    }
  },
  "scripts": {
    "start:websocket": "php server_swoole.php",
    "start:server": "php -S 0.0.0.0:8000 -t public"
  }
}
